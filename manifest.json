{
  "manifest_version": 3,
  "name": "一键清除历史记录",
  "version": "1.1",
  "description": "点击扩展图标立即清除全部浏览历史记录，仅删除历史记录。",
  "permissions": [
    "browsingData"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "清除全部历史记录",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}